{
  "name": "mid-autumn-festival",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5177 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint src tests \"scripts/**/*.mjs\" *.js --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings 0",
    "lint:css:fix": "npm run lint:css -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node scripts/check-code.mjs",
    "check:bem": "node scripts/check-bem.mjs",
    "check:performance": "node scripts/check-performance.mjs",
    "check:security": "node scripts/check-security.mjs",
    "audit:security": "npm audit --audit-level=high"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.180.0",
    "eslint": "^10.14.0",
    "globals": "^16.5.0",
    "parse5": "^7.3.0",
    "postcss": "^8.5.32",
    "postcss-selector-parser": "^7.1.8",
    "prettier": "^3.9.10",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^38.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.1.0"
  }
}
